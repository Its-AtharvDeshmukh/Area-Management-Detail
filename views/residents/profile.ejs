<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-4 mb-5">
    <!-- Header & Action Navigation -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm border">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex justify-content-center align-items-center fw-bold" style="width: 55px; height: 55px; font-size: 1.5rem;">
                <%= resident.fullName.charAt(0).toUpperCase() %>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2 class="mb-0 fw-bold text-dark"><%= resident.fullName %></h2>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1"><%= resident.relationship %></span>
                </div>
                <p class="text-muted mb-0 small"><i class="fas fa-home text-primary me-1"></i> <%= resident.familyId ? resident.familyId.fullAddress : 'Independent Resident' %></p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/residents/<%= resident._id %>/edit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                <i class="fas fa-user-edit me-1"></i> Edit Resident
            </a>
            <% if (resident.familyId) { %>
                <a href="/families/<%= resident.familyId._id %>" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                    <i class="fas fa-users me-1"></i> View Family Unit
                </a>
            <% } %>
            <a href="/residents" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="fas fa-arrow-left me-1"></i> Directory
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Personal Identity & Contact Information -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-address-card text-primary me-2"></i> Personal Profile</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-bold">
                            <i class="fas fa-tint me-1"></i> <%= resident.bloodGroup || 'Unknown' %>
                        </span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-bold">
                            <%= resident.age %> Yrs (<%= resident.gender %>)
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            <%= resident.maritalStatus || 'Single' %>
                        </span>
                    </div>

                    <h6 class="text-muted text-uppercase fw-bold fs-7 tracking-wider mb-3">Contact Channels</h6>
                    <div class="list-group list-group-flush small mb-4">
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="fas fa-phone-alt text-success me-2"></i> Primary Mobile:</span>
                            <span class="fw-bold"><%= resident.mobile || 'N/A' %></span>
                        </div>
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="fab fa-whatsapp text-success me-2"></i> WhatsApp:</span>
                            <span class="fw-bold"><%= resident.whatsappNumber || 'N/A' %></span>
                        </div>
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="fas fa-envelope text-primary me-2"></i> Email:</span>
                            <span class="fw-bold text-truncate" style="max-width: 160px;"><%= resident.email || 'N/A' %></span>
                        </div>
                    </div>

                    <h6 class="text-muted text-uppercase fw-bold fs-7 tracking-wider mb-3">Background & Occupation</h6>
                    <div class="list-group list-group-flush small">
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="fas fa-briefcase text-secondary me-2"></i> Occupation:</span>
                            <span class="fw-bold"><%= resident.occupationType === 'Other' ? resident.occupationOther : (resident.occupationType || 'N/A') %></span>
                        </div>
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="fas fa-graduation-cap text-warning me-2"></i> Education:</span>
                            <span class="fw-bold"><%= resident.education || 'N/A' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Emergency Contact Card -->
            <% if (resident.emergencyContact && resident.emergencyContact.name) { %>
            <div class="card shadow-sm border-0 rounded-4 bg-danger bg-opacity-10 border-start border-danger border-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="text-danger fw-bold mb-3"><i class="fas fa-heartbeat me-2"></i> Emergency Contact</h6>
                    <p class="mb-1 fw-bold text-dark"><%= resident.emergencyContact.name %> <span class="badge bg-danger text-white fw-normal ms-1"><%= resident.emergencyContact.relationship %></span></p>
                    <p class="mb-0 text-danger fw-bold"><i class="fas fa-phone-alt me-1"></i> <%= resident.emergencyContact.number %></p>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Right Column: Civic, Voter & Secure Information -->
        <div class="col-lg-8">
            <!-- Civic & Voter Status Card -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-vote-yea text-primary me-2"></i> Civic & Voter Registry</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-3">
                        <div class="col-sm-6">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Residency Status</span>
                            <span class="badge <%= resident.isPermanentResident ? 'bg-success bg-opacity-10 text-success border border-success-subtle' : 'bg-warning bg-opacity-10 text-warning border border-warning-subtle' %> px-3 py-2 rounded-pill fw-semibold">
                                <i class="fas fa-<%= resident.isPermanentResident ? 'check-circle' : 'clock' %> me-1"></i>
                                <%= resident.isPermanentResident ? 'Permanent Resident' : 'Temporary / Migrant' %>
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Special Needs / Disability</span>
                            <% if (resident.hasDisability) { %>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="fas fa-wheelchair me-1"></i> Yes (<%= resident.disabilityPercentage ? resident.disabilityPercentage + '%' : 'Registered' %>)
                                </span>
                            <% } else { %>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">None Reported</span>
                            <% } %>
                        </div>
                    </div>

                    <hr class="my-4">

                    <h6 class="text-muted text-uppercase fw-bold fs-7 tracking-wider mb-3">Voter List Metadata</h6>
                    <% if (resident.hasVoterId) { %>
                        <div class="row g-3 bg-light p-3 rounded-3 border">
                            <div class="col-sm-6 col-md-3">
                                <span class="text-muted small d-block">EPIC Number</span>
                                <span class="fw-bold font-monospace text-dark"><%= resident.epicNumber || 'N/A' %></span>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <span class="text-muted small d-block">Roll Serial No.</span>
                                <span class="fw-bold text-dark"><%= resident.rollSerialNumber || 'N/A' %></span>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <span class="text-muted small d-block">Booth / Part No.</span>
                                <span class="fw-bold text-dark"><%= resident.boothPartNumber || 'N/A' %></span>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <span class="text-muted small d-block">Polling Station</span>
                                <span class="fw-bold text-dark"><%= resident.pollingStation || 'N/A' %></span>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="alert alert-secondary small mb-0 py-3 rounded-3 text-center">
                            <i class="fas fa-info-circle me-1"></i> Resident does not possess or has not registered a Voter ID.
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Secure Admin Identifiers Card (RBAC Enforced) -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-shield-alt text-warning me-2"></i> Secure Identifiers</h5>
                    <% if (!isSuperAdmin) { %>
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle fw-semibold px-2.5 py-1 rounded-pill">
                            <i class="fas fa-lock me-1"></i> Restricted (Super Admin Only)
                        </span>
                    <% } else { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle fw-semibold px-2.5 py-1 rounded-pill">
                            <i class="fas fa-unlock me-1"></i> Authorized View
                        </span>
                    <% } %>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">PAN Number</span>
                            <% if (isSuperAdmin) { %>
                                <div class="p-3 bg-light border rounded-3 font-monospace fw-bold text-dark"><%= resident.panNumber || 'Not Provided' %></div>
                            <% } else { %>
                                <div class="p-3 bg-light border rounded-3 text-muted"><i class="fas fa-eye-slash me-2"></i> [Hidden]</div>
                            <% } %>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Aadhaar Number</span>
                            <% if (isSuperAdmin) { %>
                                <div class="p-3 bg-light border rounded-3 font-monospace fw-bold text-dark"><%= resident.aadhaarNumber || 'Not Provided' %></div>
                            <% } else { %>
                                <div class="p-3 bg-light border rounded-3 text-muted"><i class="fas fa-eye-slash me-2"></i> [Aadhaar Redacted]</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Household Association Card -->
            <% if (resident.familyId) { %>
            <div class="card shadow-sm border-0 rounded-4 bg-light">
                <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1">Household Unit Reference</span>
                        <h6 class="fw-bold text-dark mb-0"><%= resident.familyId.fullAddress %></h6>
                        <small class="text-muted font-monospace">Family ID: <%= resident.familyId.familyId %></small>
                    </div>
                    <a href="/families/<%= resident.familyId._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold">
                        Open Household <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>