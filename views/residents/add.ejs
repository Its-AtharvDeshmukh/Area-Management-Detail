<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white py-3">
            <h5 class="mb-0"><i class="fas fa-user-plus"></i> Add New Resident</h5>
        </div>
        
        <div class="card-body p-4">
            <form action="/residents/add" method="POST">
                <div class="row g-3">
                    <!-- Personal Details -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" required>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Mobile Number <span class="text-danger">*</span></label>
                        <input type="text" name="mobile" class="form-control" required>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Date of Birth <span class="text-danger">*</span></label>
                        <input type="date" name="dob" class="form-control" required>
                        <small class="text-muted">Age is calculated automatically.</small>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Gender</label>
                        <select name="gender" class="form-select">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Blood Group</label>
                        <select name="bloodGroup" class="form-select">
                            <option value="A+">A+</option>
                            <option value="O+">O+</option>
                            <option value="B+">B+</option>
                            <option value="AB+">AB+</option>
                            <option value="A-">A-</option>
                            <option value="O-">O-</option>
                            <option value="B-">B-</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Voter ID Number</label>
                        <input type="text" name="voterId" class="form-control" placeholder="Optional">
                    </div>

                    <!-- Moved Aadhaar Number here to complete the 12-column row -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Aadhaar Number</label>
                        <input type="text" name="aadhaarNumber" class="form-control" placeholder="12-digit number (Optional)">
                    </div>

                    <!-- Adjusted widths to col-md-4 for perfect wrapping -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Disability</label>
                        <select name="disability" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Occupation</label>
                        <input type="text" name="occupation" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Education</label>
                        <input type="text" name="education" class="form-control">
                    </div>

                    <!-- Family Linking -->
                    <hr class="mt-4">
                    <h6 class="text-muted"><i class="fas fa-users"></i> Family Connection</h6>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Select Family (Optional)</label>
                        <select name="familyId" class="form-select">
                            <option value="">None (Independent Resident)</option>
                            <% families.forEach(fam => { %>
                                <option value="<%= fam._id %>"><%= fam.familyId %> - <%= fam.headOfFamily %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Relationship to Head</label>
                        <input type="text" name="relationship" class="form-control" placeholder="e.g., Son, Wife, Self">
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <a href="/residents" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-info text-white"><i class="fas fa-save"></i> Save Resident</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>