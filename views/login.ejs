<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - Dattaham Nagar Municipal Directory</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --civic-navy: #0F2A44;
            --civic-navy-deep: #081A2C;
            --civic-brass: #B8862E;
            --civic-brass-light: #E7D3A1;
            --civic-parchment: #F7F4EE;
            --civic-paper: #FFFFFF;
            --civic-line: #E4DFD3;
            --civic-ink: #1C2530;
            --civic-ink-muted: #5B6472;
            --font-display: 'Fraunces', serif;
            --font-body: 'Inter', sans-serif;
        }
        body {
            background-color: var(--civic-parchment);
            font-family: var(--font-body);
            color: var(--civic-ink);
            min-height: 100vh;
        }
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .auth-card {
            background: var(--civic-paper);
            border: 1px solid var(--civic-line);
            border-radius: 20px;
            box-shadow: 0 12px 32px -8px rgba(15, 42, 68, 0.12);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
        }
        .auth-header {
            background: linear-gradient(135deg, var(--civic-navy) 0%, var(--civic-navy-deep) 100%);
            padding: 32px 24px;
            text-align: center;
            color: #fff;
        }
        .seal-badge {
            width: 52px; height: 52px;
            border-radius: 50%;
            border: 1.5px solid rgba(184, 134, 46, 0.55);
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--civic-brass-light);
            font-size: 1.3rem;
            background: rgba(255,255,255,0.04);
            margin-bottom: 14px;
        }
        .auth-title {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 1.6rem;
            margin-bottom: 4px;
            color: #fff;
        }
        .auth-sub {
            color: rgba(255,255,255,0.72);
            font-size: 0.88rem;
            margin: 0;
        }
        .auth-body {
            padding: 32px;
        }
        .form-control {
            border-radius: 10px;
            border: 1px solid var(--civic-line);
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
        }
        .form-control:focus {
            border-color: var(--civic-brass);
            box-shadow: 0 0 0 4px rgba(184, 134, 46, 0.15);
        }
        .form-floating > label {
            padding: 0.75rem 1rem;
            color: var(--civic-ink-muted);
        }
        .btn-civic {
            background: var(--civic-brass);
            border: 1px solid var(--civic-brass);
            color: #241a06;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.75rem;
            font-size: 0.95rem;
            width: 100%;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-civic:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px -4px rgba(184,134,46,0.5);
            color: #241a06;
            background: #c59335;
        }
        .auth-footer {
            background: #faf8f5;
            border-top: 1px solid var(--civic-line);
            padding: 16px 24px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--civic-ink-muted);
        }
        .auth-footer a {
            color: var(--civic-navy);
            font-weight: 600;
            text-decoration: none;
        }
        .auth-footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="seal-badge">
                <i class="fas fa-city"></i>
            </div>
            <h1 class="auth-title">Dattaham Nagar</h1>
            <p class="auth-sub">Municipal Digital Directory Portal</p>
        </div>
        <div class="auth-body">
            <% if (locals.error && error) { %>
                <div class="alert alert-danger border-0 shadow-sm rounded-3 small py-2 text-center mb-4" role="alert">
                    <i class="fas fa-exclamation-triangle me-1"></i> <%= error %>
                </div>
            <% } %>

            <!-- Google OAuth Button -->
            <div class="d-grid mb-3">
                <a href="/auth/google" class="btn btn-outline-dark fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm" style="border-radius: 10px; padding: 0.75rem; transition: background 0.2s ease;">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google Logo" width="22" height="22">
                    Sign in with Google
                </a>
            </div>

            <!-- Divider -->
            <div class="d-flex align-items-center mb-4">
                <hr class="flex-grow-1" style="border-color: var(--civic-line);">
                <span class="mx-3 text-muted small fw-bold">OR</span>
                <hr class="flex-grow-1" style="border-color: var(--civic-line);">
            </div>

            <!-- Standard Auth Form -->
            <form action="/login" method="POST">
                <div class="form-floating mb-3">
                    <input class="form-control" id="inputUsername" name="username" type="text" placeholder="Username" required autocomplete="username" />
                    <label for="inputUsername"><i class="fas fa-user text-muted me-2"></i>Username</label>
                </div>
                
                <div class="form-floating mb-4">
                    <input class="form-control" id="inputPassword" name="password" type="password" placeholder="Password" required autocomplete="current-password" />
                    <label for="inputPassword"><i class="fas fa-lock text-muted me-2"></i>Password</label>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-civic">Sign In</button>
                </div>
            </form>
        </div>
        <div class="auth-footer">
            Don't have an account? <a href="/register">Register as Volunteer</a>
            <div class="mt-2"><a href="/" class="small text-muted"><i class="fas fa-arrow-left me-1"></i> Return to Public Site</a></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>