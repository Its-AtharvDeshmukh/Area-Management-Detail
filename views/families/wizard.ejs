<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Mapbox GL JS CSS -->
<link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />

<div class="apple-bg-ambient pt-5 mt-4">
    <div class="container px-3 px-md-4 mb-5 pb-5">
        
        <!-- Main Wizard Glass Card -->
        <div class="glass-wizard-card mx-auto" style="max-width: 900px;">
            
            <!-- Wizard Header & Progress Bar -->
            <div class="wizard-header border-bottom">
                <h3 class="mb-4 text-dark fw-bold text-center" style="font-family: 'Fraunces', serif;">
                    <i class="fas fa-user-plus text-primary me-2"></i>New Household Registration
                </h3>
                
                <div class="position-relative w-100 px-2 px-md-4 mx-auto mt-4">
                    <div class="progress-track"><div class="progress-fill" id="wizardProgress" style="width: 0%;"></div></div>
                    <div class="d-flex justify-content-between position-relative z-2">
                        <div class="d-flex flex-column align-items-center">
                            <div class="step-indicator active-badge" id="badge-1">1</div>
                            <small class="step-label mt-2">Family</small>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <div class="step-indicator" id="badge-2">2</div>
                            <small class="step-label mt-2">Head</small>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <div class="step-indicator" id="badge-3">3</div>
                            <small class="step-label mt-2">Health</small>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <div class="step-indicator" id="badge-4">4</div>
                            <small class="step-label mt-2">Identity</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Wizard Form Body -->
            <div class="wizard-body p-3 p-md-5">
                <form id="registrationWizard" action="/families/register-wizard" method="POST">
                    
                    <!-- ================= STEP 1: HOUSEHOLD & LOCATION ================= -->
                    <div class="wizard-step active" id="step-1">
                        <div class="d-flex align-items-center mb-4">
                            <div class="step-icon-box bg-primary bg-opacity-10 text-primary me-3"><i class="fas fa-home"></i></div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Household Details</h5>
                                <p class="text-muted small mb-0">Address and community demographics</p>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <!-- NEW FIELD: Years Lived -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Years Lived in Dattadam Nagar *</label>
                                <select name="yearsLived" class="form-select apple-input" required>
                                    <option value="">Select duration...</option>
                                    <option value="Less than 1 year">Less than 1 year (New Migrant)</option>
                                    <option value="1 to 5 years">1 to 5 years</option>
                                    <option value="5 to 10 years">5 to 10 years</option>
                                    <option value="10 to 20 years">10 to 20 years</option>
                                    <option value="More than 20 years">More than 20 years</option>
                                    <option value="Since Birth">Since Birth (Native Resident)</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Ward Number</label>
                                <input type="text" name="wardNumber" class="form-control apple-input" placeholder="e.g., Ward 4">
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold text-dark small">House No. *</label>
                                <input type="text" name="houseNumber" class="form-control apple-input" required placeholder="e.g., 42-B">
                            </div>
                            <div class="col-6 col-md-5">
                                <label class="form-label fw-bold text-dark small">Building Name</label>
                                <input type="text" name="buildingName" class="form-control apple-input" placeholder="Optional">
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">PIN Code *</label>
                                <input type="text" name="pinCode" class="form-control apple-input" required placeholder="6-digit PIN">
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Street / Area *</label>
                                <input type="text" name="streetArea" class="form-control apple-input" required placeholder="Main Road">
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Landmark</label>
                                <input type="text" name="landmark" class="form-control apple-input" placeholder="Nearby landmark">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold text-dark small">Complete Address *</label>
                                <textarea name="fullAddress" class="form-control apple-input" rows="2" required placeholder="Full delivery address"></textarea>
                            </div>

                            <!-- Mapbox GPS Integration -->
                            <div class="col-12 mt-4">
                                <div class="glass-inner-box p-3 p-md-4 rounded-4">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0"><i class="fas fa-map-marked-alt text-danger me-2"></i>Map Location Pin</h6>
                                            <small class="text-muted">Tap the map or use your current device GPS.</small>
                                        </div>
                                        <button type="button" class="btn btn-gps shadow-sm" onclick="getGPS()">
                                            <i class="fas fa-crosshairs me-1"></i> Use My GPS
                                        </button>
                                    </div>
                                    
                                    <div id="gpsStatus" class="small mb-2 fw-semibold" style="display:none;"></div>
                                    <div id="mapPicker" class="rounded-4 shadow-sm border border-light mb-3"></div>

                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="text" id="lat" name="lat" class="form-control apple-input font-monospace text-muted" placeholder="Latitude" readonly>
                                        </div>
                                        <div class="col-6">
                                            <input type="text" id="lng" name="lng" class="form-control apple-input font-monospace text-muted" placeholder="Longitude" readonly>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ================= STEP 2: HEAD OF FAMILY ================= -->
                    <div class="wizard-step" id="step-2">
                        <div class="d-flex align-items-center mb-4">
                            <div class="step-icon-box bg-success bg-opacity-10 text-success me-3"><i class="fas fa-user-tie"></i></div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Head of Family Details</h5>
                                <p class="text-muted small mb-0">Primary representative information</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Full Legal Name *</label>
                                <input type="text" name="fullName" class="form-control apple-input" required placeholder="Enter full name">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold text-dark small">Gender *</label>
                                <select name="gender" class="form-select apple-input" required>
                                    <option value="">Select...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold text-dark small">Date of Birth *</label>
                                <input type="date" name="dob" class="form-control apple-input" required>
                            </div>
                            
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">Primary Mobile *</label>
                                <input type="tel" name="mobile" class="form-control apple-input" pattern="[0-9]{10}" required placeholder="10-digit number">
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">WhatsApp Number</label>
                                <input type="tel" name="whatsappNumber" class="form-control apple-input" pattern="[0-9]{10}" placeholder="Optional">
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">Marital Status</label>
                                <select name="maritalStatus" class="form-select apple-input">
                                    <option value="Married">Married</option>
                                    <option value="Single">Single</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Divorced">Divorced</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Occupation</label>
                                <select name="occupationType" id="occupationSelect" class="form-select apple-input" onchange="toggleOtherOcc()">
                                    <option value="Salaried Employee">Salaried Employee</option>
                                    <option value="Business">Business</option>
                                    <option value="Farmer">Farmer</option>
                                    <option value="Student">Student</option>
                                    <option value="Housewife">Housewife</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6" id="otherOccDiv" style="display:none;">
                                <label class="form-label fw-bold text-dark small">Specify Occupation</label>
                                <input type="text" name="occupationOther" id="occupationOther" class="form-control apple-input" placeholder="Enter details">
                            </div>
                        </div>
                    </div>

                    <!-- ================= STEP 3: HEALTH & EMERGENCY ================= -->
                    <div class="wizard-step" id="step-3">
                        <div class="d-flex align-items-center mb-4">
                            <div class="step-icon-box bg-danger bg-opacity-10 text-danger me-3"><i class="fas fa-heartbeat"></i></div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Health & Emergency</h5>
                                <p class="text-muted small mb-0">Medical profile and emergency contacts</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">Blood Group</label>
                                <select name="bloodGroup" class="form-select apple-input">
                                    <option value="Unknown">Unknown</option>
                                    <option value="A+">A+</option><option value="B+">B+</option>
                                    <option value="O+">O+</option><option value="AB+">AB+</option>
                                    <option value="A-">A-</option><option value="O-">O-</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-8">
                                <label class="form-label fw-bold text-danger small">Does the person have a Disability?</label>
                                <select name="hasDisability" id="hasDisability" class="form-select apple-input border-danger" onchange="toggleDisability()">
                                    <option value="false">No</option>
                                    <option value="true">Yes</option>
                                </select>
                            </div>

                            <div class="col-12" id="disabilityFields" style="display:none;">
                                <div class="glass-inner-box p-3 rounded-4 border-danger border-opacity-25">
                                    <div class="row g-2">
                                        <div class="col-12 col-md-6">
                                            <input type="text" name="disabilityType" class="form-control apple-input" placeholder="Type of Disability">
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <input type="number" name="disabilityPercentage" class="form-control apple-input" placeholder="Percentage (%)">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-4"><hr class="text-muted"></div>
                            
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">Emergency Contact Name</label>
                                <input type="text" name="emergencyName" class="form-control apple-input" placeholder="Full name">
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label fw-bold text-dark small">Relationship</label>
                                <input type="text" name="emergencyRelation" class="form-control apple-input" placeholder="e.g. Brother">
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label fw-bold text-dark small">Emergency Phone</label>
                                <input type="tel" name="emergencyNumber" class="form-control apple-input" pattern="[0-9]{10}" placeholder="10 digits">
                            </div>
                        </div>
                    </div>

                    <!-- ================= STEP 4: IDENTITY & VOTER ================= -->
                    <div class="wizard-step" id="step-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="step-icon-box bg-warning bg-opacity-10 text-warning me-3"><i class="fas fa-id-card"></i></div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Identity & Voter Roll</h5>
                                <p class="text-muted small mb-0">Civic registration details</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Permanent Resident?</label>
                                <select name="isPermanentResident" class="form-select apple-input">
                                    <option value="true">Yes</option>
                                    <option value="false">No (Temporary/Migrant)</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-primary small">Has Voter ID (EPIC)?</label>
                                <select name="hasVoterId" id="hasVoterId" class="form-select apple-input border-primary" onchange="toggleVoterFields()">
                                    <option value="false">No</option>
                                    <option value="true">Yes</option>
                                </select>
                            </div>

                            <div class="col-12" id="voterFields" style="display:none;">
                                <div class="glass-inner-box p-3 p-md-4 rounded-4 border-primary border-opacity-25">
                                    <div class="row g-3">
                                        <div class="col-12 col-md-4">
                                            <input type="text" name="epicNumber" class="form-control apple-input" placeholder="EPIC / Voter ID Number">
                                        </div>
                                        <div class="col-6 col-md-4">
                                            <input type="text" name="rollSerialNumber" class="form-control apple-input" placeholder="Roll Serial No.">
                                        </div>
                                        <div class="col-6 col-md-4">
                                            <input type="text" name="boothPartNumber" class="form-control apple-input" placeholder="Booth / Part No.">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <div class="glass-inner-box p-3 p-md-4 rounded-4 border-warning border-opacity-25 bg-warning bg-opacity-10">
                                    <h6 class="text-dark fw-bold small mb-2"><i class="fas fa-shield-alt text-warning me-2"></i>Secure Identity</h6>
                                    <p class="text-muted small mb-3">This number is encrypted and restricted to authorized administrators.</p>
                                    <input type="text" name="aadhaarNumber" class="form-control apple-input font-monospace bg-white" placeholder="[12-Digit Number]">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ================= NAVIGATION BUTTONS ================= -->
                    <div class="d-grid d-md-flex justify-content-md-between mt-5 pt-4 border-top gap-3">
                        <button type="button" class="btn btn-glass-back px-4 fw-bold rounded-pill order-2 order-md-1" id="prevBtn" onclick="nextPrev(-1)" style="display:none;">
                            <i class="fas fa-arrow-left me-2"></i> Previous
                        </button>
                        <button type="button" class="btn btn-solid-next px-5 fw-bold rounded-pill shadow-sm order-1 order-md-2" id="nextBtn" onclick="nextPrev(1)">
                            Next Step <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Mapbox GL JS -->
<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>

<style>
    /* Apple Liquid Glass Background */
    .apple-bg-ambient {
        min-height: 100vh;
        background-color: #f1f5f9;
        background-image: 
            radial-gradient(circle at 80% 0%, rgba(79, 70, 229, 0.08) 0%, transparent 40%),
            radial-gradient(circle at 20% 100%, rgba(16, 185, 129, 0.06) 0%, transparent 40%);
        background-attachment: fixed;
    }

    /* Glass Card */
    .glass-wizard-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(25px) saturate(200%);
        -webkit-backdrop-filter: blur(25px) saturate(200%);
        border: 1px solid rgba(255, 255, 255, 1);
        border-radius: 24px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }
    
    .wizard-header { padding: 2rem 1.5rem; background: rgba(255,255,255,0.4); }
    @media (min-width: 768px) { .wizard-header { padding: 3rem 3rem 2rem 3rem; } }

    /* Progress Indicators */
    .progress-track { position: absolute; top: 18px; left: 0; width: 100%; height: 4px; background: #e2e8f0; z-index: 1; border-radius: 4px; }
    .progress-fill { height: 100%; background: #4f46e5; transition: width 0.4s ease; border-radius: 4px; }
    
    .step-indicator { 
        width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; 
        border-radius: 50%; background: #f8fafc; border: 2px solid #e2e8f0; color: #64748b; 
        font-weight: 700; font-size: 0.95rem; z-index: 2; transition: all 0.3s ease; 
    }
    .step-indicator.active-badge { background: #4f46e5; color: white; border-color: #4f46e5; box-shadow: 0 0 0 5px rgba(79, 70, 229, 0.15); }
    .step-indicator.completed { background: #10b981; color: white; border-color: #10b981; }
    
    .step-label { font-weight: 600; color: #64748b; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
    @media (max-width: 575.98px) { .step-label { display: none; } } /* Hide text on small screens to prevent squishing */

    /* Step Visibility */
    .wizard-step { display: none; }
    .wizard-step.active { display: block; animation: slideFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    @keyframes slideFadeUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

    /* Typography & Icons */
    .step-icon-box { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    
    /* Inputs */
    .apple-input {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
        color: #1e293b;
        transition: all 0.2s ease;
    }
    .apple-input:focus {
        background-color: #ffffff;
        border-color: #4f46e5;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    }
    
    /* Inner Glass Boxes */
    .glass-inner-box { background: rgba(241, 245, 249, 0.6); border: 1px solid rgba(226, 232, 240, 0.8); }

    /* Mapbox */
    #mapPicker { height: 280px; width: 100%; border-radius: 16px; z-index: 1; }
    .btn-gps { background: #ffffff; border: 1px solid #e2e8f0; color: #ef4444; font-weight: 600; font-size: 0.85rem; border-radius: 50px; padding: 0.4rem 1rem; }
    .btn-gps:hover { background: #fef2f2; border-color: #fca5a5; }

    /* Navigation Buttons */
    .btn-solid-next {
        background: #4f46e5; color: #ffffff; border: none; padding: 0.8rem 2rem;
        font-size: 0.95rem; transition: all 0.2s ease;
    }
    .btn-solid-next:hover { background: #4338ca; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(79, 70, 229, 0.3) !important; color: white;}
    .btn-solid-next.btn-success { background: #10b981; }
    .btn-solid-next.btn-success:hover { background: #059669; box-shadow: 0 6px 20px rgba(16, 185, 129, 0.3) !important; }

    .btn-glass-back {
        background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 0.8rem 2rem;
        font-size: 0.95rem; transition: all 0.2s ease;
    }
    .btn-glass-back:hover { background: #e2e8f0; color: #0f172a; }
</style>

<script>
    mapboxgl.accessToken = '<%= mapToken %>';
    let currentTab = 0;
    let map = null;
    let marker = null;

    showTab(currentTab);

    function showTab(n) {
        let x = document.getElementsByClassName("wizard-step");
        x[n].classList.add("active");
        
        document.getElementById("prevBtn").style.display = n === 0 ? "none" : "block";
        
        if (n === (x.length - 1)) {
            document.getElementById("nextBtn").innerHTML = '<i class="fas fa-save me-2"></i> Submit Registration';
            document.getElementById("nextBtn").classList.replace('btn-primary', 'btn-success');
        } else {
            document.getElementById("nextBtn").innerHTML = 'Next Step <i class="fas fa-arrow-right ms-2"></i>';
            document.getElementById("nextBtn").classList.replace('btn-success', 'btn-primary');
        }

        let progress = (n / (x.length - 1)) * 100;
        document.getElementById("wizardProgress").style.width = progress + "%";
        
        for(let i = 1; i <= 4; i++) {
            let badge = document.getElementById("badge-" + i);
            badge.className = "step-indicator";
            if (i < n + 1) badge.classList.add("completed");
            if (i === n + 1) badge.classList.add("active-badge");
        }

        if (n === 0 && !map) {
            setTimeout(() => { initMap(79.0882, 21.1458); }, 250);
        }
    }

    function initMap(lng, lat) {
        map = new mapboxgl.Map({
            container: 'mapPicker',
            style: 'mapbox://styles/mapbox/streets-v12',
            center: [lng, lat],
            zoom: 14
        });
        map.addControl(new mapboxgl.NavigationControl(), 'top-right');
        map.on('click', function(e) { setMarker(e.lngLat.lng, e.lngLat.lat); });
    }

    function setMarker(lng, lat) {
        document.getElementById('lat').value = lat.toFixed(6);
        document.getElementById('lng').value = lng.toFixed(6);

        if (marker) {
            marker.setLngLat([lng, lat]);
        } else {
            marker = new mapboxgl.Marker({ color: '#ef4444', draggable: true })
                .setLngLat([lng, lat])
                .addTo(map);

            marker.on('dragend', function() {
                let pos = marker.getLngLat();
                document.getElementById('lat').value = pos.lat.toFixed(6);
                document.getElementById('lng').value = pos.lng.toFixed(6);
            });
        }
        map.flyTo({ center: [lng, lat], zoom: 16, essential: true });
    }

    function getGPS() {
        const statusBox = document.getElementById('gpsStatus');
        statusBox.style.display = 'block';
        statusBox.innerHTML = '<span class="text-primary"><i class="fas fa-spinner fa-spin me-2"></i>Fetching accurate location...</span>';

        if (!navigator.geolocation) {
            statusBox.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-2"></i>GPS not supported by your browser.</span>';
            return;
        }

        navigator.geolocation.getCurrentPosition(
            position => {
                setMarker(position.coords.longitude, position.coords.latitude);
                statusBox.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-2"></i>GPS locked successfully!</span>';
            }, 
            error => {
                statusBox.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-2"></i>Failed to get GPS. Please tap map manually.</span>';
            }, 
            { timeout: 10000, enableHighAccuracy: true }
        );
    }

    function nextPrev(n) {
        let x = document.getElementsByClassName("wizard-step");
        if (n == 1 && !validateForm()) return false;
        
        x[currentTab].classList.remove("active");
        currentTab = currentTab + n;
        
        if (currentTab >= x.length) {
            document.getElementById("registrationWizard").submit();
            return false;
        }
        showTab(currentTab);
        // Scroll to top of card on step change for mobile
        document.querySelector('.glass-wizard-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function validateForm() {
        let x = document.getElementsByClassName("wizard-step")[currentTab];
        let inputs = x.querySelectorAll("[required]");
        let valid = true;
        for (let i = 0; i < inputs.length; i++) {
            if (inputs[i].value == "") {
                inputs[i].classList.add("is-invalid");
                inputs[i].classList.add("border-danger");
                valid = false;
            } else {
                inputs[i].classList.remove("is-invalid");
                inputs[i].classList.remove("border-danger");
            }
        }
        return valid;
    }

    function toggleOtherOcc() {
        const select = document.getElementById("occupationSelect").value;
        const div = document.getElementById("otherOccDiv");
        const input = document.getElementById("occupationOther");
        if (select === 'Other') {
            div.style.display = 'block';
            input.setAttribute('required', 'true');
        } else {
            div.style.display = 'none';
            input.removeAttribute('required');
        }
    }

    function toggleDisability() {
        document.getElementById("disabilityFields").style.display = document.getElementById("hasDisability").value === 'true' ? 'block' : 'none';
    }

    function toggleVoterFields() {
        document.getElementById("voterFields").style.display = document.getElementById("hasVoterId").value === 'true' ? 'block' : 'none';
    }
</script>

