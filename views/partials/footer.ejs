<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Capacitor Native Hardware Back Button Support -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.Capacitor && window.Capacitor.Plugins.App) {
            window.Capacitor.Plugins.App.addListener('backButton', (info) => {
                const path = window.location.pathname;
                // If on the home, login, or dashboard page, exit the app
                if (path === '/' || path === '/login' || path === '/admin/dashboard') {
                    window.Capacitor.Plugins.App.exitApp();
                } else {
                    // Otherwise, go back to the previous page
                    window.history.back();
                }
            });
        }
    });
</script>
</body>
</html>