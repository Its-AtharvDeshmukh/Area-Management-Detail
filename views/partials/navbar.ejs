    }
    .custom-link:hover { color: var(--nb-navy-deep) !important; background: rgba(15,42,74,0.06); }
    .custom-link.active {
        color: var(--nb-navy-deep) !important;
        background: rgba(15,42,74,0.10);
        border: 1px solid rgba(15,42,74,0.16);
    }

    .volunteer-link {
        color: var(--nb-brass) !important;
        background: rgba(184,134,59,0.12);
        border: 1px solid rgba(184,134,59,0.25);
    }
    .volunteer-link:hover { background: rgba(184,134,59,0.2) !important; color: #8a6428 !important; }

    /* Action Buttons */
    .btn-public {
        font-size: 0.88rem; font-weight: 600; padding: 0.55rem 1.3rem; border-radius: 999px;
        color: var(--nb-navy-deep) !important;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        min-height: 40px;
        transition: all 0.2s ease; text-decoration: none;
