        border-radius: 12px;
        background: linear-gradient(135deg, var(--nb-navy) 0%, var(--nb-navy-deep) 100%);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.4);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.05rem; flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(15,42,74,0.35);
