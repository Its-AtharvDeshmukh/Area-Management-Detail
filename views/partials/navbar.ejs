    .brand-title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.05rem; color: var(--nb-navy-deep); letter-spacing: -0.01em; }
    .brand-subtitle { font-size: 0.6rem; font-weight: 600; color: var(--nb-brass); text-transform: uppercase; letter-spacing: 0.06em; }

    /* Mobile Hamburger */
    .toggler-btn {
        width: 42px; height: 42px;
        border-radius: 12px;
        background: rgba(255,255,255,0.8);
        backdrop-filter: blur(10px);
        border: 1px solid #cbd5e1;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: all 0.2s ease;
        font-size: 1.1rem; color: var(--nb-navy-deep);
    }
    .toggler-btn:active { transform: scale(0.94); background: #ffffff; }

    /* Nav Links */
    .custom-link {
        color: var(--nb-slate) !important;
        font-weight: 600; font-size: 0.9rem;
        padding: 0.6rem 1.1rem !important;
