    .btn-public:hover { background: #f8fafc !important; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15,23,42,0.08) !important; }

    .btn-logout {
        font-size: 0.88rem; font-weight: 600; padding: 0.55rem 1.3rem; border-radius: 999px;
        color: #ffffff !important;
        background: linear-gradient(135deg, var(--nb-navy) 0%, var(--nb-navy-deep) 100%) !important;
        border: 1px solid rgba(255,255,255,0.25) !important;
