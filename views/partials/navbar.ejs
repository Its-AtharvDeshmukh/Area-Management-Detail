        --nb-navy: #0f2a4a;
        --nb-navy-deep: #0a1f38;
        --nb-brass: #b8863b;
        --nb-slate: #475569;
        --nb-emerald: #0f9d6a;
        --nb-glass-bg: rgba(255, 255, 255, 0.88);
        --nb-glass-border: rgba(255, 255, 255, 0.7);
    }

    /* Base Navbar - Frosted glass, fixed top with guaranteed high z-index */
    .premium-nav {
        min-height: 70px;
        background: var(--nb-glass-bg) !important;
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
